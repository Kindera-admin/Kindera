# Copy to .env.local and fill in. Never commit real values.

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority

# Signs the auth-token cookie (jose, HS256). Generate with: openssl rand -hex 32
JWT_SECRET=


# Initial admin account, used by `npm run create-admin`
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Cloudinary (image and document uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
