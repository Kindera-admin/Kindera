# Copy to .env.local and fill in. Never commit real values.

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority

# Signs the auth-token cookie (jose, HS256). Generate with: openssl rand -hex 32
JWT_SECRET=


# Initial admin account, used by /api/setup and `npm run create-admin`
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Required as ?secret= on /api/setup and /api/seed-ngo-partners
SETUP_SECRET=

# Required as `Authorization: Bearer <CRON_SECRET>` on /api/cron/wrap-up
CRON_SECRET=

# Cloudinary (image and document uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
